{
  "compilerOptions": {
    "target": "es2022",
    "ignoreDeprecations": "6.0",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "tsup.config.ts", "vitest.config.ts"]
}
